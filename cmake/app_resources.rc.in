/* 由 CMake 的 configure_file 生成，不要直接编辑。
 * @APP_ICON_ICO_RC@ 是构建期算出的绝对路径。
 * 本文件按 UTF-8 保存，CMakeLists 会给 windres 传 --codepage=65001；
 * 否则中文 Windows 下 © 会被按 GBK 解释成 "?"。 */

IDI_APP_ICON ICON "@APP_ICON_ICO_RC@"

1 VERSIONINFO
FILEVERSION @APP_VERSION_RC@
PRODUCTVERSION @APP_VERSION_RC@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EnderDavid"
            VALUE "FileDescription", "localappdata cleaner executable"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "localappdata_cleaner"
            VALUE "LegalCopyright", "© 2026 EnderDavid, <mcenddavid@126.com>"
            VALUE "OriginalFilename", "localappdata_cleaner.exe"
            VALUE "ProductName", "localappdata cleaner executable"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
